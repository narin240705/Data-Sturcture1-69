#include <stdio.h>

int main() {
    char name[50], choice;              /* ประกาศตัวแปร */
    float price, sum, total, vat, grand;
    int qty;

    total = 0;                          /* total = 0 */

    do {
        printf("product name: ");
        scanf("%s", name);              /* รับ name */
        printf("price: ");
        scanf("%f", &price);            /* รับ price */
        printf("quantity: ");
        scanf("%d", &qty);              /* รับ qty */

        sum = price * qty;              /* sum = price * qty */
        total = total + sum;            /* total = total + sum */

        printf("%s  price: %.2f  qty: %d  sum: %.2f\n", name, price, qty, sum);
                                        /* แสดง name, price, qty, sum */

        printf("Add more? (y/n): ");
        scanf(" %c", &choice);          /* รับ choice (y=ต่อ, n=จบ) */
    } while (choice != 'n' && choice != 'N');
                                        /* choice != n ? (Yes = วนกลับไปรับ name) */

    vat = total * 0.07;                 /* vat = total * 0.07 */
    grand = total + vat;                /* grand = total + vat */

    printf("Total: %.2f\n", total);     /* แสดง total, vat, grand */
    printf("VAT 7%%: %.2f\n", vat);
    printf("Grand total: %.2f\n", grand);

    return 0;                           /* จบ */
}
