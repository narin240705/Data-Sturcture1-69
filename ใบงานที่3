#include <stdio.h>
#include <string.h>

int main() {
    char str[100];                          /* declare str, i, j, len, end */
    int i, j, len, end;

    printf("--> ");                         /* show "--> " */
    scanf(" %99[^\n]", str);                /* read str (whole line, spaces allowed) */

    printf("==> ");                         /* show "--> " (start of the result line) */

    len = strlen(str);                      /* len = strlen(str) */
    end = len - 1;                          /* end = len - 1 (last position of the current word) */

    /* scan from right to left; i = -1 means "before the first character" */
    for (i = len - 1; i >= -1; i--) {       /* i = len - 1 ; i >= -1 ; i = i - 1 */

        if (i == -1 || str[i] == ' ') {     /* found a space, or reached the start */

            for (j = i + 1; j <= end; j++) {    /* j = i + 1 ; j <= end ; j = j + 1 */
                printf("%c", str[j]);           /* show str[j] (print the word) */
            }

            if (i != -1) {                  /* no space after the last word */
                printf(" ");                /* show space */
            }

            end = i - 1;                    /* end = i - 1 (the next word ends before this space) */
        }
    }
    printf("\n");                           /* show new line */

    return 0;                               /* stop */
}
