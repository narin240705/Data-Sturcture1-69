#include <stdio.h>
#include <string.h>

int main() {
    char s[100], *w[50], *p;
    int n = 0;

    printf("--> ");
    scanf(" %99[^\n]", s);

    for (p = strtok(s, " "); p; p = strtok(NULL, " "))
        w[n++] = p;

    printf("==> ");
    while (n--) printf("%s%s", w[n], n ? " " : "");
    printf("\n");
    return 0;
}
