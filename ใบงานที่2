#include <stdio.h>

int main() {
    int a[10], i, max;                  /* ประกาศ a[10], i, max */

    printf("Input 10 number => ");

    /* ---- ลูปที่ 1: รับค่า 10 ตัวเก็บใน array ---- */
    for (i = 0; i < 10; i++) {          /* i = 0 ; i < 10 ? ; i = i + 1 */
        scanf("%d", &a[i]);             /* รับค่า a[i] */
    }

    /* ---- ลูปที่ 2: หาค่ามากที่สุด ---- */
    max = a[0];                         /* max = a[0] */
    for (i = 1; i < 10; i++) {          /* i = 1 ; i < 10 ? ; i = i + 1 */
        if (a[i] > max) {               /* a[i] > max ? */
            max = a[i];                 /* max = a[i] */
        }
    }

    printf("Max is %d\n", max);         /* แสดง max */

    return 0;                           /* จบ */
}
