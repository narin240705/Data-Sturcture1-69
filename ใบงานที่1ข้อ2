#include <stdio.h>

int main() {
    int a[10], i;                       /* ประกาศ a[10], i */

    /* ---- ลูปที่ 1: รับค่าตัวเลข 10 ตัว ---- */
    for (i = 0; i < 10; i++) {          /* i = 0 ; i < 10 ? ; i = i + 1 */
        printf("Num => %d: ", i);
        scanf("%d", &a[i]);             /* รับค่า a[i] */
    }

    /* ---- ลูปที่ 2: แสดงเลขคู่ ---- */
    printf("Even: ");                   /* แสดง "Even:" */
    for (i = 0; i < 10; i++) {          /* i = 0 ; i < 10 ? ; i = i + 1 */
        if (a[i] % 2 == 0) {            /* a[i] % 2 == 0 ? */
            printf("%d ", a[i]);        /* แสดง a[i] */
        }
    }
    printf("\n");

    /* ---- ลูปที่ 3: แสดงเลขคี่ ---- */
    printf("Odd: ");                    /* แสดง "Odd:" */
    for (i = 0; i < 10; i++) {          /* i = 0 ; i < 10 ? ; i = i + 1 */
        if (a[i] % 2 != 0) {            /* a[i] % 2 != 0 ? */
            printf("%d ", a[i]);        /* แสดง a[i] */
        }
    }
    printf("\n");

    return 0;                           /* จบ */
}
