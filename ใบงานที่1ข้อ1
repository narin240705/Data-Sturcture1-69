#include <stdio.h>

int main() {
    int num1, num2;

    printf("num1: ");
    scanf("%d", &num1);

    printf("num2: ");
    scanf("%d", &num2);

    if (num2 != 0 && num1 % num2 == 0) {
        int n = num1 / num2;
        printf("%d เป็นผลคูณของ %d เนื่องจาก %d คูณกับตัวเลขใด ๆ "
               "(ในที่นี้คือ %d) แล้วมีค่าเท่ากับ %d\n",
               num1, num2, num2, n, num1);
    } else {
        printf("%d ไม่เป็นผลคูณของ %d เนื่องจาก %d ไม่สามารถคูณกับตัวเลขใด ๆ "
               "แล้วมีค่าเท่ากับ %d\n",
               num1, num2, num2, num1);
    }

    return 0;
}
